{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/youtube",
      "destination": "/youtube.html"
    },
    {
      "source": "/instagram",
      "destination": "/instagram.html"
    },
    {
      "source": "/facebook",
      "destination": "/facebook.html"
    },
    {
      "source": "/twitter",
      "destination": "/twitter.html"
    },
    {
      "source": "/stats",
      "destination": "/stats.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "yt-dlp"
    }
  }
}
